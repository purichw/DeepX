{
  "name": "deepx-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test:content": "node --experimental-strip-types --test tests/content.test.ts",
    "test:seo": "node --experimental-strip-types --test tests/seo.test.ts",
    "test": "node --experimental-strip-types --test tests/content.test.ts tests/seo.test.ts tests/studio.test.ts src/cms/model.test.ts",
    "check:schema": "node scripts/check-cms-schema.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.0",
    "@fontsource-variable/noto-sans-thai": "^5.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "^3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
